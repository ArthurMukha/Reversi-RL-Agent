# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Виртуальные окружения
.venv/
venv/
env/

# Обученные веса моделей
*.pt
*.pth
*.ckpt
*.onnx

# ...кроме отобранных версий: они едут в репозиторий, чтобы игра работала
# сразу после клонирования. Отрицание обязано идти после паттерна *.pt.
# Сюда кладём только отобранные модели, а не каждую итерацию арены:
# git хранит все версии навсегда.
!model_service/checkpoints/*.pt

# Go — бинарники сборки (пересобираются, в git не нужны)
game-service/server
*.exe

# Личные заметки (не для репозитория)
docs/

# Jupyter
.ipynb_checkpoints/

# IDE / ОС
.vscode/
.idea/
.DS_Store
